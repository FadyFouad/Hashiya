    "settings.deleteDownloadedMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "few" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "حذف %2$@ ملفات PDF مُنزَّلة؟ يمكنك تنزيلها مرة أخرى. ستبقى الملفات المُرفَقة."
                    }
                  },
                  "many" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "حذف %2$@ ملفًا مُنزَّلًا بصيغة PDF؟ يمكنك تنزيلها مرة أخرى. ستبقى الملفات المُرفَقة."
                    }
                  },
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "حذف ملف PDF المُنزَّل؟ يمكنك تنزيله مرة أخرى. ستبقى الملفات المُرفَقة."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "حذف %2$@ من ملفات PDF المُنزَّلة؟ يمكنك تنزيلها مرة أخرى. ستبقى الملفات المُرفَقة."
                    }
                  },
                  "two" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "حذف ملفَي PDF المُنزَّلَين؟ يمكنك تنزيلهما مرة أخرى. ستبقى الملفات المُرفَقة."
                    }
                  },
                  "zero" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "حذف ملفات PDF المُنزَّلة؟ يمكنك تنزيلها مرة أخرى. ستبقى الملفات المُرفَقة."
                    }
                  }
                }
              }
            }
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Delete %2$@ downloaded PDF? You can download it again. Attached PDFs are kept."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Delete %2$@ downloaded PDFs? You can download them again. Attached PDFs are kept."
